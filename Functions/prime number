#include <stdio.h>

int primenumber(int a);

int main()
{
    int a, ans;

    printf("Enter a number: ");
    scanf("%d", &a);

    ans = primenumber(a);

    if (ans == 1)
    {
        printf("It is a prime number\n");
    }
    else
    {
        printf("It is not a prime number\n");
    }

    return 0;
}

int primenumber(int a)
{
    int x;

    if (a <= 1)
    {
        return 0;
    }

    for (x = 2; x < a; x++)
    {
        if (a % x == 0)
        {
            return 0;
        }
    }

    return 1;
}
